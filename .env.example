APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# POD Onboarding Materials & Knowledge Base (UNA-021 / UNA-022)
POD_MATERIALS_DISK=local
POD_MATERIALS_DIR=pod_materials
POD_MATERIALS_MAX_FILE_SIZE_KB=20480
POD_MATERIALS_EXTRACTION_ENABLED=true
POD_MATERIALS_AI_PROVIDER=gemini
POD_MATERIALS_EXTRACTION_QUEUE=default
POD_MATERIALS_EXTRACTION_TIMEOUT=120
POD_MATERIALS_EXTRACTION_TRIES=3
POD_MATERIALS_MAX_EXTRACTED_CHARS=500000

# Gemini AI Extraction Provider Settings
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=8192
